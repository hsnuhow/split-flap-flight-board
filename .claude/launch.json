{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Firebase Local Preview",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["emulators:start", "--only", "hosting"],
      "port": 5003
    },
    {
      "name": "Static Preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8099", "--directory", "public"],
      "port": 8099
    }
  ]
}
